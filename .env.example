# ── Copy this file to .env and fill in your values ──────────────────────────
# Never commit .env to git (it's in .gitignore)

# ── Telegram (RECOMMENDED — instant phone push notifications) ────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Start a chat with your new bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# ── Gmail (backup email alerts) ───────────────────────────────────────────────
# Use a Gmail App Password (NOT your main password):
# Google Account → Security → 2-Step Verification → App Passwords
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── OpenAI (optional — improves accuracy of weak-signal detection) ────────────
# Only ~$0.10-0.50/month. Leave blank to disable LLM verification.
OPENAI_API_KEY=sk-...

# ── Behavior ─────────────────────────────────────────────────────────────────
# Set DRY_RUN=true to test the pipeline without sending real alerts
DRY_RUN=false

# Reduce this number to test on fewer professors (default: all 100)
MAX_PROFESSORS_PER_RUN=100

# Logging level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
